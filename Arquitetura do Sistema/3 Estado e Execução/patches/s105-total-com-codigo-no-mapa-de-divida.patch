+// "TOTAL" COM CÓDIGO NA FRENTE É SUBTOTAL — e o banco não o enxerga assim.
+//
+// O DEFEITO (arnês de variações, variante `codigo_contabil_no_rotulo`): `fn_papel_linha` ancora o
+// prefixo "total" no INÍCIO do rótulo, e "2.3.71 TOTAL — saldo devedor" começa por "2.3.71". Papel
+// `conta`, portanto: a linha de TOTAL do mapa de dívida virou uma tranche a mais. Medido: tranches
+// 51.300 (o total) + 51.300 (as nove contas) = 102.600 de dívida existente onde o documento diz
+// 51.300; a dívida de curto prazo de 2024 saiu 46.924 contra 23.462 sem o código. O saldo dobrado
+// era amortizado em 3 anos, o caixa não cobria, o revolver engolia a diferença e voltava a 0 na
+// virada ("a dívida evapora: de 11.114 para 0 entre J e K, amortização 0"). Balancete de ERP traz
+// o código em quase toda linha, inclusive no TOTAL.
+//
+// A regra é a MESMA da (a) de `fn_papel_linha` (prefixo total|totais|subtotal|soma), aplicada ao
+// rótulo SEM o código, e só quando há código — sem ele o banco já decide e esta função não
+// discorda dele. A correção definitiva é a do banco (a função SQL tirar o código antes de
+// comparar); até lá, o portal não pode somar um total como se fosse conta.
+const TOTAL_NO_INICIO = /^(?:total|totais|subtotal|soma)(?: |$)/;
+export const ehTotalComCodigoNaFrente = (chave: string) =>
+  CODIGO_DE_CONTA_NO_INICIO.test(String(chave ?? "")) && TOTAL_NO_INICIO.test(chaveDeAncora(chave));
